# Copie este arquivo para .env e preencha os valores
SECRET_KEY=sua-chave-secreta-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados (padrão: SQLite para desenvolvimento)
DB_ENGINE=sqlite

# Para usar MySQL em produção:
# DB_ENGINE=mysql
# DB_NAME=uneworld
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Webhook da Resend (rastreamento de entrega/leitura) — opcional em dev, veja DEPLOY.md
RESEND_WEBHOOK_SECRET=

# MaxMind GeoLite2 — gratuito em https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Libera exclusão definitiva (purge) na lixeira — só superusuário. Manter False em produção.
ALLOW_HARD_DELETE=False

# Autentique (assinatura digital) — https://www.autentique.com.br
# SANDBOX=True cria documentos de teste (sem valor jurídico). DELIVERY: email|whatsapp|sms.
# Configure na Autentique o webhook: {BACKEND_URL}/api/contracts/autentique-webhook/?secret=<WEBHOOK_SECRET>
AUTENTIQUE_API_TOKEN=
AUTENTIQUE_SANDBOX=True
AUTENTIQUE_DELIVERY=email
AUTENTIQUE_WEBHOOK_SECRET=

# --- Verificação do contrato assinado (QR) ---
# No upload do contrato assinado, lê os QR de cada página e confere se o PDF é
# ESTE contrato, na versão atual, com todas as páginas na ordem.
# True (padrão) = liga; False = aceita o upload sem conferir.
CONTRACT_QR_VERIFY=True

# --- Retenção dos logs de auditoria (poda automática) ---
# Idade MÁXIMA, em DIAS, de cada tipo de log. VAZIO = infinito (guarda pra sempre).
# Navegação/movimento (páginas visitadas + login/logout). Ex.: 365 = 1 ano.
AUDIT_NAVIGATION_RETENTION_DAYS=
# Mudanças no banco (criação/edição/exclusão de registros). Ex.: 3650 = 10 anos.
AUDIT_CHANGE_RETENTION_DAYS=
