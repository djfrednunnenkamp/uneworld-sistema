# Copie este arquivo para ".env" na raiz do projeto e preencha os valores.
# Usado pelo docker-compose.yml / docker-compose.prod.yml.

# --- Django ---
SECRET_KEY=troque-por-uma-chave-secreta-bem-aleatoria
DEBUG=False
ALLOWED_HOSTS=seu-dominio.com.br,www.seu-dominio.com.br
CORS_ALLOWED_ORIGINS=https://seu-dominio.com.br
CSRF_TRUSTED_ORIGINS=https://seu-dominio.com.br

# --- Banco de dados (Postgres, container "db" do compose) ---
DB_NAME=uneworld
DB_USER=uneworld
DB_PASSWORD=troque-por-uma-senha-forte

# --- Porta pública exposta pelo container "frontend" (nginx) ---
# A Cloudflare (ou outro proxy) aponta para esta porta via HTTP simples —
# o TLS público é terminado na Cloudflare, não aqui.
HTTP_PORT=80

# --- E-mail (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=UneWorld Turismo <noreply@uneworld.com.br>
FRONTEND_URL=https://seu-dominio.com.br
BACKEND_URL=https://seu-dominio.com.br

# Webhook da Resend (rastreamento de entrega/leitura dos e-mails enviados).
# Configure em https://resend.com/webhooks: URL "https://seu-dominio.com.br/api/agenda/resend-webhook/",
# eventos: email.sent, email.delivered, email.bounced, email.delivery_delayed, email.opened.
# Copie o "Signing Secret" gerado lá para esta variável.
RESEND_WEBHOOK_SECRET=

# --- MaxMind GeoLite2 (opcional — localização aproximada por IP no audit log) ---
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# --- OnlyOffice Document Server (opcional — edição de Word/Excel/PowerPoint/PDF ---
# na aba Observações do roteiro). Deixe vazio para desligar (o site então só
# permite baixar/visualizar os documentos, sem edição no navegador).
#   ONLYOFFICE_DS_URL      URL pública do Document Server (onde o NAVEGADOR o acessa)
#   ONLYOFFICE_JWT_SECRET  segredo compartilhado — igual ao JWT_SECRET do container do DS
#   ONLYOFFICE_BACKEND_URL URL deste backend alcançável PELO container do DS (baixar/salvar).
#                          Local/Linux: use o IP da máquina (ex.: http://192.168.1.55:8000),
#                          não "localhost". Produção: o domínio do backend.
# Suba o servidor com o MESMO segredo:
#   docker run -d --name onlyoffice -p 8080:80 -e JWT_SECRET=troque-por-um-segredo onlyoffice/documentserver
ONLYOFFICE_DS_URL=
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_BACKEND_URL=

# --- Tag da imagem a usar no docker-compose.prod.yml (ex: latest, ou um SHA/versão) ---
TAG=latest
