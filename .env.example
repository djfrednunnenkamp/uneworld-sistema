# Copie este arquivo para ".env" na raiz do projeto e preencha os valores.
# Usado pelo docker-compose.yml / docker-compose.prod.yml.

# --- Django ---
SECRET_KEY=troque-por-uma-chave-secreta-bem-aleatoria
DEBUG=False
ALLOWED_HOSTS=seu-dominio.com.br,www.seu-dominio.com.br
CORS_ALLOWED_ORIGINS=https://seu-dominio.com.br
CSRF_TRUSTED_ORIGINS=https://seu-dominio.com.br

# --- Banco de dados (Postgres, container "db" do compose) ---
DB_NAME=uneworld
DB_USER=uneworld
DB_PASSWORD=troque-por-uma-senha-forte

# --- Porta pública exposta pelo container "frontend" (nginx) ---
# A Cloudflare (ou outro proxy) aponta para esta porta via HTTP simples —
# o TLS público é terminado na Cloudflare, não aqui.
HTTP_PORT=80

# --- E-mail (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=UneWorld Turismo <noreply@uneworld.com.br>
FRONTEND_URL=https://seu-dominio.com.br
BACKEND_URL=https://seu-dominio.com.br

# --- MaxMind GeoLite2 (opcional — localização aproximada por IP no audit log) ---
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# --- Tag da imagem a usar no docker-compose.prod.yml (ex: latest, ou um SHA/versão) ---
TAG=latest
