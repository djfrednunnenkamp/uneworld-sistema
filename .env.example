# Copie este arquivo para ".env" na raiz do projeto e preencha os valores.
# Usado pelo docker-compose.yml / docker-compose.prod.yml.

# --- Django ---
SECRET_KEY=troque-por-uma-chave-secreta-bem-aleatoria
DEBUG=False
ALLOWED_HOSTS=backend-intranet.uneworld.com.br,intranet.uneworld.com.br,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://intranet.uneworld.com.br
CSRF_TRUSTED_ORIGINS=https://intranet.uneworld.com.br,https://backend-intranet.uneworld.com.br

# Cookies de sessão/CSRF compartilhados entre os subdomínios (front e back), pois
# o front chama a API cross-origin. Use o domínio-pai comum aos dois subdomínios.
SESSION_COOKIE_DOMAIN=.uneworld.com.br
CSRF_COOKIE_DOMAIN=.uneworld.com.br

# Nº de proxies confiáveis à frente do Django (para o rate-limit ler o IP real do
# X-Forwarded-For sem confiar no valor forjável do cliente). Só Nginx Proxy Manager
# = 1; Cloudflare -> NPM = 2. Errar aqui não é falha grave, mas ajuste conforme a
# topologia real.
TRUSTED_PROXY_COUNT=1

# Nível de log (DEBUG, INFO, WARNING, ERROR). Em produção use INFO.
LOG_LEVEL=INFO

# --- Banco de dados (Postgres EXTERNO — não roda no compose) ---
DB_ENGINE=postgresql
DB_HOST=147.93.8.118
DB_PORT=5450
DB_NAME=uneworld_intranet
DB_USER=uneworld_intranet_admin
DB_PASSWORD=troque-por-uma-senha-forte

# --- Porta publicada no host para o Daphne (NPM aponta pra cá; 5800 livre) ---
BACKEND_PORT=5800

# --- E-mail (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=UneWorld Turismo <noreply@uneworld.com.br>
FRONTEND_URL=https://seu-dominio.com.br
BACKEND_URL=https://seu-dominio.com.br

# Webhook da Resend (rastreamento de entrega/leitura dos e-mails enviados).
# Configure em https://resend.com/webhooks: URL "https://seu-dominio.com.br/api/agenda/resend-webhook/",
# eventos: email.sent, email.delivered, email.bounced, email.delivery_delayed, email.opened.
# Copie o "Signing Secret" gerado lá para esta variável.
RESEND_WEBHOOK_SECRET=

# --- E-mail SMTP (fallback — usado só quando RESEND_API_KEY está VAZIO) ---
# Se preencher EMAIL_HOST (ex.: Mailgun) e deixar RESEND_API_KEY vazio, o envio sai
# por SMTP. O rastreamento por webhook do Resend não se aplica nesse modo.
# EMAIL_FROM deve ser de um domínio autorizado no provedor SMTP.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=

# --- MaxMind GeoLite2 (opcional — localização aproximada por IP no audit log) ---
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# --- Autentique (assinatura digital de contratos) ---
# ATENÇÃO: AUTENTIQUE_SANDBOX=True gera documentos de TESTE, SEM validade jurídica.
# Em produção, para assinaturas reais, defina AUTENTIQUE_SANDBOX=False e um token real.
# AUTENTIQUE_WEBHOOK_SECRET protege o endpoint público chamado pela Autentique.
AUTENTIQUE_API_TOKEN=
AUTENTIQUE_SANDBOX=False
AUTENTIQUE_WEBHOOK_SECRET=

# --- OnlyOffice Document Server (edição de Word/Excel/PowerPoint/PDF no navegador) ---
# O DS agora sobe junto no docker-compose.yml (serviço "onlyoffice"), na MESMA rede
# do backend. Deixe as 3 variáveis vazias para DESLIGAR a edição (o site então só
# permite baixar/visualizar os documentos).
#   ONLYOFFICE_DS_URL      URL PÚBLICA do Document Server (onde o NAVEGADOR o acessa).
#                          É o domínio roteado pelo NPM -> ONLYOFFICE_PORT. Ex.:
#                          https://office-intranet.uneworld.com.br
#   ONLYOFFICE_JWT_SECRET  segredo compartilhado. A MESMA variável alimenta o backend
#                          E o container do DS (JWT_SECRET no compose). OBRIGATÓRIO:
#                          sem ele, o callback de salvar é rejeitado (fail-closed) e
#                          a edição não grava. Gere com: openssl rand -hex 32
#   ONLYOFFICE_BACKEND_URL URL deste backend alcançável PELO container do DS. Como DS e
#                          backend estão na mesma rede do compose, use o nome de serviço:
#                          http://backend:8000  (NUNCA localhost).
ONLYOFFICE_DS_URL=
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_BACKEND_URL=http://backend:8000

# Porta publicada no host para o Document Server (NPM aponta o domínio do DS pra cá).
# Use uma porta livre; DIFERENTE entre develop e prod se rodarem no mesmo servidor.
ONLYOFFICE_PORT=8080

# --- Armazenamento de mídia PÚBLICA no S3 (OPCIONAL) ---
# Se preenchido, imagens públicas (logos, imagens/vídeos de roteiro, avatares, fotos,
# vouchers) vão DIRETO pro S3 (não ocupam o disco). Vazio = filesystem local.
# Documentos SENSÍVEIS (docs de passageiro/roteiro, contratos, Drive) NUNCA vão pro S3.
# O prefixo separa ambientes/projetos no mesmo bucket. O prefixo precisa ter leitura
# pública (bucket policy) para as URLs das imagens funcionarem.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=
S3_PREFIX=uneworld/intranet/images/prod

# --- Monitoramento de erros (Sentry) — OPCIONAL ---
# Cole o DSN do projeto no Sentry para receber os erros de produção. Vazio = desligado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Tag da imagem a usar no docker-compose.prod.yml (ex: latest, ou um SHA/versão) ---
TAG=latest
